# Parking LPR System — Environment Variables
# Copy to .env and fill in your values

# ---- Flask ----
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# ---- Database ----
DB_PATH=/app/data/parking.db
UPLOAD_FOLDER=/app/data/uploads

# ---- OCR Service (internal Docker network) ----
OCR_SERVICE_URL=http://ocr:5001/ocr

# ---- WeChat Mini-Program ----
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ---- WeChat Pay (Merchant) ----
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_NOTIFY_URL=https://your-domain.com/api/payment/callback
WECHAT_CERT_PATH=/app/certs/apiclient_cert.pem
WECHAT_KEY_PATH=/app/certs/apiclient_key.pem

# ---- Barrier Gate (network relay) ----
GATE_RELAY_HOST=192.168.1.200
GATE_RELAY_PORT=80

# ---- Camera (RTSP) ----
RTSP_URL=rtsp://admin:password@192.168.1.100:554/h264/ch1/main/av_stream
CAPTURE_DIR=uploads

# ---- Gate Worker ----
BACKEND_URL=http://localhost:5000
GATE_TYPE=simulated
ENTRY_GATE_ID=entry_gate
EXIT_GATE_ID=exit_gate
GATE_DIRECTION=entry
