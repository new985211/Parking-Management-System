# Parking LPR System — Environment Variables
# Copy to .env and fill in your values

# Flask
SECRET_KEY=change-me-to-a-random-string

# WeChat Mini-Program
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_API_KEY=
WECHAT_NOTIFY_URL=https://your-domain.com/api/payment/callback

# Barrier Gate (network relay)
GATE_RELAY_HOST=192.168.1.200
GATE_RELAY_PORT=80

# OCR Service (internal)
OCR_SERVICE_URL=http://ocr:5001/ocr

# Database
DB_PATH=/app/data/parking.db
