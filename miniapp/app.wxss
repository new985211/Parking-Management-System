/* ============================================================
   Parking LPR Mini-Program — Design System v2
   ============================================================ */

/* ---- Design Tokens ---- */
page {
  --brand: #667eea;
  --brand-end: #764ba2;
  --brand-gradient: linear-gradient(135deg, #667eea, #764ba2);
  --success: #22c55e;
  --warning: #f59e0b;
  --danger: #ef4444;
  --info: #3b82f6;
  --revenue: #f59e0b;
  --bg: #f1f5f9;
  --surface: #ffffff;
  --border: #e2e8f0;
  --text: #1e293b;
  --text-muted: #64748b;
  --text-dim: #94a3b8;
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,.04);
  --shadow-md: 0 8rpx 24rpx rgba(0,0,0,.06);

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  color: var(--text);
  font-size: 28rpx;
  line-height: 1.6;
}

/* ---- Header Card ---- */
.header-card {
  background: var(--brand-gradient);
  color: #fff;
  padding: 40rpx 40rpx 48rpx;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: 0 12rpx 40rpx rgba(102, 126, 234, 0.2);
}
.header-card .page-title {
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
  letter-spacing: 2rpx;
}
.header-card .page-subtitle {
  font-size: 26rpx;
  opacity: .8;
  font-weight: 400;
}

/* ---- Card ---- */
.card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  margin: 24rpx 32rpx;
  box-shadow: var(--shadow-sm);
}
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

/* ---- Stat Grid ---- */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin: 24rpx 32rpx;
}
.stat-card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32rpx 24rpx;
  text-align: center;
  box-shadow: var(--shadow-sm);
}
.stat-number {
  font-size: 52rpx;
  font-weight: 800;
  color: var(--brand);
  font-variant-numeric: tabular-nums;
}
.stat-label {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
  font-weight: 500;
}

/* ---- Plate Display ---- */
.plate-text {
  font-size: 40rpx;
  font-weight: 700;
  font-family: "DIN Alternate", "Arial Rounded MT Bold", monospace;
  letter-spacing: 4rpx;
  font-variant-numeric: tabular-nums;
}
.plate-box {
  background: #1a5fb4;
  color: #fff;
  border: 6rpx solid #fff;
  border-radius: 12rpx;
  padding: 18rpx 28rpx;
  font-size: 38rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  display: inline-block;
  box-shadow: 0 4rpx 16rpx rgba(26,95,180,.25);
  font-variant-numeric: tabular-nums;
}

/* ---- Tags ---- */
.tag {
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 32rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.5;
}
.tag-enter { background: #f0fdf4; color: #16a34a; }
.tag-exit  { background: #fef2f2; color: #dc2626; }
.tag-pending { background: #fffbeb; color: #d97706; }
.tag-monthly { background: #eff6ff; color: #2563eb; }

.fee-text {
  color: var(--revenue);
  font-weight: 700;
  font-size: 32rpx;
}

/* ---- Buttons ---- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 26rpx 32rpx;
  border-radius: var(--radius-md);
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  margin: 24rpx 32rpx;
  transition: all .15s ease;
  min-height: 88rpx;
}
.btn-primary {
  background: var(--brand-gradient);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}
.btn-primary:active {
  opacity: .85;
  transform: scale(.97);
}
.btn-secondary {
  background: var(--bg);
  color: var(--text-muted);
}
.btn-secondary:active { background: #e2e8f0; }
.btn-danger {
  background: var(--danger);
  color: #fff;
}
.btn-danger:active { opacity: .85; }

/* WeChat Pay branded button */
.btn-wxpay {
  background: #07c160;
  color: #fff;
  font-size: 34rpx;
  box-shadow: 0 8rpx 24rpx rgba(7,193,96,.3);
}
.btn-wxpay:active { opacity: .85; transform: scale(.97); }

/* ---- Inputs ---- */
.input-group {
  margin: 20rpx 32rpx;
}
.input-label {
  font-size: 28rpx;
  color: var(--text-muted);
  font-weight: 600;
  margin-bottom: 10rpx;
  display: block;
}
.input {
  width: 100%;
  padding: 26rpx 28rpx;
  border: 2rpx solid var(--border);
  border-radius: var(--radius-md);
  font-size: 32rpx;
  background: var(--surface);
  color: var(--text);
  box-sizing: border-box;
  min-height: 88rpx;
}
.input:focus { border-color: var(--brand); }

/* ---- Record Item ---- */
.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.record-item:last-child { border-bottom: none; }

/* ---- Empty State ---- */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: var(--text-dim);
  font-size: 28rpx;
}
.empty-state-icon { font-size: 80rpx; margin-bottom: 16rpx; opacity: .6; }
.empty-state-hint { font-size: 24rpx; color: var(--text-dim); margin-top: 8rpx; }

/* ---- Skeleton Screen ---- */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: var(--radius-sm);
}
.skeleton-card {
  height: 120rpx;
  margin: 24rpx 32rpx;
  border-radius: var(--radius-lg);
}
.skeleton-text {
  height: 32rpx;
  margin-bottom: 16rpx;
  border-radius: 8rpx;
}
.skeleton-title {
  height: 48rpx;
  width: 60%;
  margin-bottom: 24rpx;
  border-radius: 8rpx;
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ---- Divider ---- */
.divider {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 0;
  color: var(--text-dim);
  font-size: 24rpx;
}
.divider::before,
.divider::after {
  content: "";
  flex: 1;
  height: 1rpx;
  background: var(--border);
}
.divider text {
  padding: 0 24rpx;
  background: var(--bg);
}

/* ---- Pull-to-refresh animation ---- */
.refresh-hint {
  text-align: center;
  padding: 20rpx;
  color: var(--text-dim);
  font-size: 24rpx;
}

/* ---- Success Animation ---- */
.success-anim {
  text-align: center;
  padding: 60rpx 0;
}
.success-anim .icon {
  font-size: 120rpx;
  animation: bounceIn .6s ease;
}
.success-anim .text {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--success);
  margin-top: 16rpx;
}
@keyframes bounceIn {
  0% { transform: scale(0); opacity: 0; }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); opacity: 1; }
}
