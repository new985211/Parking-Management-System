/* Global Styles - Gradient Card Theme */
page {
  background: #f0f2f5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  color: #333;
}

.header-card {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  padding: 30rpx 40rpx;
  border-radius: 0 0 30rpx 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.25);
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 10rpx;
}

.page-subtitle {
  font-size: 26rpx;
  opacity: 0.85;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 20rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin: 20rpx 30rpx;
}

.stat-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}

.stat-number {
  font-size: 56rpx;
  font-weight: 700;
  color: #667eea;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.plate-text {
  font-size: 44rpx;
  font-weight: 700;
  font-family: monospace;
  letter-spacing: 4rpx;
  color: #333;
}

.plate-box {
  background: #1a5fb4;
  color: #fff;
  border: 6rpx solid #fff;
  border-radius: 12rpx;
  padding: 16rpx 24rpx;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  display: inline-block;
  box-shadow: 0 4rpx 12rpx rgba(26,95,180,0.3);
}

.record-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.record-item:last-child { border-bottom: none; }

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.tag-enter { background: #e8f5e9; color: #2e7d32; }
.tag-exit { background: #fce4ec; color: #c62828; }
.tag-pending { background: #fff3e0; color: #e65100; }

.fee-text { color: #f093fb; font-weight: 600; font-size: 30rpx; }

.btn {
  display: block;
  padding: 24rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  margin: 20rpx 30rpx;
}
.btn-primary {
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.3);
}
.btn-primary:active { opacity: 0.85; }
.btn-secondary {
  background: #f0f2f5;
  color: #666;
}

.input-group {
  margin: 20rpx 30rpx;
}
.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}
.input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  font-size: 30rpx;
  background: #fff;
  box-sizing: border-box;
}
.input:focus { border-color: #667eea; }

.empty-state {
  text-align: center;
  padding: 80rpx 0;
  color: #ccc;
  font-size: 28rpx;
}
