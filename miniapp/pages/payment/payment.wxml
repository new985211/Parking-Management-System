<view class="header-card">
  <view class="page-title">💰 停车缴费</view>
  <view class="page-subtitle">微信支付 · 快速出场</view>
</view>

<!-- Success state -->
<view wx:if="{{paid}}" class="card" style="text-align:center;">
  <view class="success-anim">
    <view class="icon">✅</view>
    <view class="text">支付成功</view>
  </view>
  <view style="color:var(--text-muted);margin-top:8rpx;font-size:26rpx;">道闸即将开启，请尽快通行</view>
</view>

<!-- Has active parking -->
<block wx:elif="{{currentParking}}">
  <view class="card" style="text-align:center;">
    <view class="plate-box">{{currentParking.plate_number}}</view>
  </view>

  <view class="stat-grid">
    <view class="stat-card">
      <view class="stat-number" style="font-size:40rpx;">{{currentParking.duration_text || '--'}}</view>
      <view class="stat-label">停车时长</view>
    </view>
    <view class="stat-card">
      <view class="stat-number" style="color:var(--revenue);">¥{{currentParking.fee || 0}}</view>
      <view class="stat-label">应缴费用</view>
    </view>
  </view>

  <view wx:if="{{currentParking.fee > 0}}">
    <button class="btn btn-wxpay" bindtap="doPayment" loading="{{paying}}" disabled="{{paying}}">
      <text wx:if="{{!paying}}">💚 微信支付 ¥{{currentParking.fee}}</text>
      <text wx:else>支付中…</text>
    </button>
    <view style="text-align:center;color:var(--text-dim);font-size:22rpx;margin-top:8rpx;">
      支付后道闸自动开启
    </view>
  </view>
  <view wx:else class="card" style="text-align:center;">
    <view style="font-size:60rpx;margin-bottom:12rpx;">🎉</view>
    <view style="font-weight:700;color:var(--success);font-size:32rpx;">免费停车</view>
    <view class="empty-state-hint">30分钟内免费，无需缴费</view>
  </view>
</block>

<!-- No active parking -->
<block wx:else>
  <view class="card empty-state">
    <view class="empty-state-icon">🚗</view>
    <view style="font-weight:600;">没有待缴费记录</view>
    <view class="empty-state-hint">车辆入场后停车费将在此显示</view>
  </view>
</block>
