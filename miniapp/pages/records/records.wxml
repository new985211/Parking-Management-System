<view class="header-card">
  <view class="page-title">📋 停车记录</view>
  <view class="page-subtitle">历史出入记录 · 上拉加载更多</view>
</view>

<view wx:if="{{records.length === 0 && !loading}}" class="empty-state" style="margin-top:80rpx;">
  <view class="empty-state-icon">📭</view>
  <view style="font-weight:600;">暂无停车记录</view>
  <view class="empty-state-hint">车辆出入后将在此显示</view>
</view>

<view wx:for="{{records}}" wx:key="id">
  <view class="card" style="margin-bottom:0;border-radius:0;border-bottom:1rpx solid var(--border);">
    <view class="record-item">
      <view>
        <view class="plate-text" style="font-size:36rpx;">{{item.plate_number}}</view>
        <view style="margin-top:8rpx;">
          <text class="tag tag-{{item.event_type}}">{{item.event_type === 'enter' ? '🚗 入场' : '🏁 出场'}}</text>
          <text wx:if="{{item.fee > 0}}" class="fee-text" style="margin-left:12rpx;">¥{{item.fee}}</text>
        </view>
      </view>
      <view style="text-align:right;">
        <view style="font-size:24rpx;color:var(--text-dim);">{{item.created_at}}</view>
        <view wx:if="{{item.parking_duration > 0}}" style="font-size:24rpx;color:var(--text-dim);margin-top:4rpx;">
          {{item.parking_duration >= 3600 ? (item.parking_duration / 3600).toFixed(1) + '小时' : (item.parking_duration / 60).toFixed(0) + '分钟'}}
        </view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{loading}}" style="padding:40rpx;text-align:center;color:var(--text-dim);">
  <view class="skeleton skeleton-text" style="height:24rpx;width:40%;margin:0 auto 12rpx;"></view>
  <view class="skeleton skeleton-text" style="height:24rpx;width:25%;margin:0 auto;"></view>
</view>

<view wx:if="{{!hasMore && records.length > 0}}" class="divider">
  <text>— 没有更多了 —</text>
</view>
