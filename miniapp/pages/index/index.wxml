<view class="header-card">
  <view class="page-title">🅿️ 我的车辆</view>
  <view class="page-subtitle">停车场智能管理 · 实时停车状态</view>
</view>

<!-- Skeleton loading -->
<block wx:if="{{loading}}">
  <view class="skeleton skeleton-card"></view>
  <view class="skeleton skeleton-card"></view>
  <view class="skeleton skeleton-card" style="height:200rpx;"></view>
</block>

<!-- Has vehicle -->
<block wx:elif="{{vehicle}}">
  <view class="card" style="text-align:center;">
    <view style="font-size:26rpx;color:var(--text-muted);margin-bottom:12rpx;">已绑定车牌</view>
    <view class="plate-box">{{vehicle.plate_number}}</view>
    <view style="margin-top:12rpx;">
      <text class="tag {{vehicle.vehicle_type === 'monthly' ? 'tag-monthly' : ''}}">
        {{vehicle.vehicle_type === 'monthly' ? '⭐ 月租车' : vehicle.vehicle_type === 'vip' ? '💎 VIP' : '普通车辆'}}
      </text>
    </view>
  </view>

  <block wx:if="{{currentParking}}">
    <view class="card">
      <view style="font-size:28rpx;color:var(--text-muted);margin-bottom:16rpx;">当前停车</view>
      <view class="stat-grid" style="margin:0;">
        <view class="stat-card">
          <view class="stat-number" style="color:var(--success);">🅿️</view>
          <view class="stat-label">在场</view>
        </view>
        <view class="stat-card">
          <view class="stat-number" style="color:var(--revenue);">¥{{currentParking.fee || 0}}</view>
          <view class="stat-label">当前费用</view>
        </view>
      </view>
      <view style="text-align:center;margin-top:20rpx;color:var(--text-muted);font-size:24rpx;">
        已停车 {{currentParking.duration_text || '--'}}
      </view>
    </view>
  </block>

  <view wx:else class="card empty-state">
    <view class="empty-state-icon">🚗</view>
    <view>当前未在场内停车</view>
    <view class="empty-state-hint">入场后自动显示停车状态</view>
  </view>
</block>

<!-- No vehicle -->
<block wx:else>
  <view class="card empty-state">
    <view class="empty-state-icon">🚙</view>
    <view style="font-weight:600;margin-bottom:8rpx;">暂未绑定车牌</view>
    <view class="empty-state-hint">绑定后可查看停车记录和在线缴费</view>
    <navigator url="/pages/bind/bind" class="btn btn-primary" style="margin:32rpx 0 0 0;">去绑定车牌 →</navigator>
  </view>
</block>
