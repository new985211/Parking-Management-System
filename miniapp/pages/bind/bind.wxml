<view class="header-card">
  <view class="page-title">🔗 绑定车牌</view>
  <view class="page-subtitle">绑定后可查看停车记录和在线缴费</view>
</view>

<!-- Already bound -->
<view wx:if="{{vehicle}}" class="card" style="text-align:center;">
  <view style="font-size:26rpx;color:var(--success);margin-bottom:12rpx;font-weight:600;">✅ 已绑定</view>
  <view class="plate-box">{{vehicle.plate_number}}</view>
  <view style="margin-top:24rpx;color:var(--text-muted);font-size:26rpx;">
    车主: {{vehicle.owner_name || '--'}} &nbsp; 电话: {{vehicle.phone || '--'}}
  </view>
  <button class="btn btn-danger" bindtap="doUnbind" style="margin-top:32rpx;">解绑车牌</button>
</view>

<!-- Bind form -->
<block wx:else>
  <view class="card">
    <view class="input-group" style="margin:0;">
      <view class="input-label">车牌号 <text style="color:var(--danger);">*</text></view>
      <input class="input" placeholder="粤B12345" value="{{plate}}" bindinput="onPlateInput" maxlength="10" placeholder-class="input-placeholder"/>
    </view>
    <view class="input-group" style="margin:24rpx 0 0 0;">
      <view class="input-label">车主姓名</view>
      <input class="input" placeholder="张三" value="{{ownerName}}" bindinput="onNameInput" placeholder-class="input-placeholder"/>
    </view>
    <view class="input-group" style="margin:24rpx 0 0 0;">
      <view class="input-label">联系电话</view>
      <input class="input" type="number" placeholder="13800138000" value="{{phone}}" bindinput="onPhoneInput" maxlength="11" placeholder-class="input-placeholder"/>
    </view>
  </view>

  <button class="btn btn-primary" bindtap="doBind" loading="{{binding}}" disabled="{{binding}}">
    {{binding ? '绑定中…' : '✅ 确认绑定'}}
  </button>

  <view style="text-align:center;color:var(--text-dim);font-size:24rpx;margin-top:16rpx;">
    一个微信号只能绑定一个车牌
  </view>
</block>
